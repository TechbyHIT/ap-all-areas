# storage-manager configuration
# Installed to /etc/storage-manager/storage-manager.conf
#
# Only KEY=VALUE lines are allowed. The manager refuses to start on anything
# else, so this file can never turn into a root shell script.
#
# Booleans accept true/false, yes/no, 1/0, on/off.
# After editing, check it with:  storage-manager config && storage-manager health

# ----------------------------------------------------------------- disk target
# The filesystem to watch. Everything below is measured against this mount.
DISK_PATH=/

# The ceiling the manager tries to stay under, in percent used. On a 200 GB
# disk, 70% is 140 GB used / 60 GB free.
MAX_USAGE_PERCENT=70

# Threshold ladder, in percent used. Each level does a little more than the one
# below it, except CRITICAL and EMERGENCY, which deliberately do LESS: under
# real pressure the manager narrows to system-owned data and alerts a human.
#
#   < WARNING            nothing runs
#   >= WARNING           apt cache, journal, rotated logs
#   >= CLEANUP           + old temp files
#   >= AGGRESSIVE        + package manager caches, logrotate, enabled opt-ins
#   >= CRITICAL          system categories only, opt-ins force-disabled, alert
#   >= EMERGENCY         system categories only, opt-ins force-disabled, alert
WARNING_USAGE_PERCENT=70
CLEANUP_USAGE_PERCENT=80
AGGRESSIVE_USAGE_PERCENT=85
CRITICAL_USAGE_PERCENT=90
EMERGENCY_USAGE_PERCENT=95

# Absolute free-space floor, in GB. Cleanup also starts when free space is
# below this even if the percentage looks fine, and an automatic run stops as
# soon as usage is under MAX_USAGE_PERCENT and this much is free.
TARGET_FREE_GB=60

# ------------------------------------------------------------------- retention
# Rotated log files older than this many days may be deleted. Active logs are
# never deleted and never truncated, at any level.
LOG_RETENTION_DAYS=14
# Entries in TEMP_DIRS older than this many days may be deleted, unless a
# process still has them open.
TEMP_RETENTION_DAYS=7
# systemd journal caps, applied with journalctl --vacuum-* only.
JOURNAL_MAX_SIZE=300M
JOURNAL_MAX_AGE=14d

# --------------------------------------------------------------------- discovery
PROJECT_DISCOVERY=true
# Where to look for applications. Never put / or a system directory here; the
# manager refuses to start if you do.
DISCOVERY_ROOTS=/srv/sites /var/www /opt /home /root
DISCOVERY_MAX_DEPTH=3

# Fleet registry written by deploy/server-setup.sh. When present it is
# authoritative: every slug in it is a project, whatever discovery finds.
SITE_REGISTRY=/etc/ap-sites/sites.d
SITE_ROOT=/srv/sites

# Projects that must never be touched by any opt-in cleanup, even when every
# other guard passes. Slugs or absolute paths, space separated. A project can
# also protect itself with a .storage-manager-protect file in its directory.
CRITICAL_PROJECTS=

# ---------------------------------------------------- safe system-level cleanup
# These only ever touch data the operating system owns and regenerates.
ENABLE_APT_CLEANUP=true
ENABLE_JOURNAL_CLEANUP=true
ENABLE_PM2_LOG_ROTATION=true
ENABLE_NGINX_LOG_ROTATION=true
ENABLE_SYSTEM_LOG_CLEANUP=true
ENABLE_TEMP_CLEANUP=true
ENABLE_PKG_CACHE_CLEANUP=true
# Run the system's own logrotate under pressure. nginx is told to reopen its
# log files by logrotate's postrotate (a USR1 signal); it is never restarted.
RUN_LOGROTATE_ON_PRESSURE=true

# apt autoremove uninstalls packages. Leave this off unless you have proven it
# safe on this exact server; the manager still never runs it automatically.
ENABLE_APT_AUTOREMOVE=false

# Let the manager install and configure the pm2-logrotate module. This does not
# stop, restart or reload any application, but it does change PM2's own state,
# so it only ever happens from an explicit `storage-manager pm2-logrotate
# --apply`, never from the timer.
PM2_LOGROTATE_AUTOCONFIGURE=false

# ------------------------------------------------- project-level cleanup (opt-in)
# All of these are false by default and should stay false unless you have a
# specific reason. Enabling one does NOT make it unconditional: the project must
# be OFFLINE in PM2, not deploying, git-clean, not critical, and have both a
# package manifest and a lock file before anything of its own is touched. All
# four are force-disabled at CRITICAL and EMERGENCY levels regardless.
ALLOW_NEXT_CACHE_CLEANUP=false
ALLOW_NEXT_BUILD_CLEANUP=false
ALLOW_NODE_MODULES_CLEANUP=false
ALLOW_STALE_RELEASE_CLEANUP=false
# Releases kept per site when ALLOW_STALE_RELEASE_CLEANUP is on. The live
# release is always kept on top of this.
KEEP_RELEASES=2

# ------------------------------------------------------------------------ paths
STATE_DIR=/var/lib/storage-manager
LOG_DIR=/var/log/storage-manager
LOCK_FILE=/var/lock/storage-manager.lock

# A project is treated as DEPLOYING when <DEPLOY_LOCK_DIR>/<slug>.deploy.lock
# exists, so a deploy script can fence itself off with a single touch.
DEPLOY_LOCK_DIR=/var/lock
# Locks that mean a deployment is running somewhere in the fleet.
GLOBAL_DEPLOY_LOCKS=/var/lock/ap-sites-build.lock

PM2_LOG_DIRS=/root/.pm2/logs /home/*/.pm2/logs /srv/sites/*/shared/logs
NGINX_LOG_DIR=/var/log/nginx
SYSTEM_LOG_DIR=/var/log
TEMP_DIRS=/tmp /var/tmp
PKG_CACHE_PATHS=/root/.npm/_cacache /home/*/.npm/_cacache

# Never deleted or modified, whatever else says otherwise.
PROTECTED_PATHS=/etc /usr /bin /sbin /lib /lib64 /boot /root/.ssh /var/lib/postgresql /var/lib/mysql /var/backups /etc/nginx /etc/letsencrypt /etc/ssl

# ------------------------------------------------------------------ performance
# The disk check runs every 15 minutes. These two keep the expensive work rare.
PROJECT_SCAN_INTERVAL_MIN=360
LARGE_FILE_SCAN_INTERVAL_MIN=1440
LARGE_FILE_MIN_MB=500
LARGE_FILE_SCAN_ROOTS=/
# A build, release or .next tree touched this recently means a deploy may still
# be in flight, so the project is left alone.
DEPLOY_RECENT_MIN=10
NICE_LEVEL=19

# --------------------------------------------------------- the manager's own logs
LOG_MAX_SIZE_MB=20
LOG_KEEP=5

# Optional hook, called as: ALERT_COMMAND "<subject>" "<path to report file>"
# Use it for mail, Slack or a webhook. Failure here never affects a run.
ALERT_COMMAND=
