# nginx reverse proxy → PM2 Next.js standalone (port 3001)
# Copy to: /etc/nginx/sites-available/skinvisiblegrills.conf
# Enable:  ln -s /etc/nginx/sites-available/skinvisiblegrills.conf /etc/nginx/sites-enabled/
# Test:    nginx -t && systemctl reload nginx
#
# Multi-site: one server{} block per domain, change server_name + proxy_pass port
# (3001, 3002, 3003…).

upstream sk_invisible_grills_node {
    # HOSTNAME=localhost binds one loopback family; list both so nginx 502s
    # do not appear when the kernel prefers IPv4 or IPv6.
    server [::1]:3001 max_fails=1 fail_timeout=10s;
    server 127.0.0.1:3001 max_fails=1 fail_timeout=10s;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # Redirect HTTP → HTTPS (after certbot)
    # return 301 https://$host$request_uri;

    client_max_body_size 12m;

    location / {
        proxy_pass http://sk_invisible_grills_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    # Optional: cache Next static aggressively at the edge
    location /_next/static/ {
        proxy_pass http://sk_invisible_grills_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}

# After: certbot --nginx -d example.com -d www.example.com
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name example.com www.example.com;
#     # ssl_certificate … (managed by certbot)
#     … same location blocks as above …
# }
