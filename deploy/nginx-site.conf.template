# Managed by deploy/site-add.sh — regenerating a site overwrites this file.
# Site: __SLUG__  ->  loopback:__PORT__ (IPv6 and IPv4)

upstream __SLUG___upstream {
    # PM2 sets HOSTNAME=localhost. Next then binds *one* loopback family —
    # [::1] on some Ubuntu hosts, 127.0.0.1 on others. Listing only one
    # address 502s whenever the kernel prefers the other. Both are cheap
    # (connection refused is immediate); max_fails skips the dead family.
    server [::1]:__PORT__ max_fails=1 fail_timeout=10s;
    server 127.0.0.1:__PORT__ max_fails=1 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __ALIASES__;

    # certbot inserts the 443 block and the HTTP->HTTPS redirect here.

    client_max_body_size 12m;

    # Per-site logs, size-capped by /etc/logrotate.d/ap-sites.
    access_log /var/log/nginx/__SLUG__.access.log;
    error_log  /var/log/nginx/__SLUG__.error.log warn;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml
               application/xml+rss text/javascript image/svg+xml;

    # Sitemap XML can be larger than the HTML buffer pool. Tiny buffers make
    # nginx abort the upstream response (502/500) — Google then reports
    # "Couldn't fetch".
    location ~* ^/(sitemap\.xml|sitemaps/.+\.xml)$ {
        proxy_pass http://__SLUG___upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 32 16k;
        proxy_busy_buffers_size 64k;
        proxy_max_temp_file_size 32m;
    }

    # Immutable hashed assets: cache hard, and do not log them. On a 50-site box
    # static-asset access logs are a large share of log volume.
    location /_next/static/ {
        proxy_pass http://__SLUG___upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /images/ {
        proxy_pass http://__SLUG___upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /favicon.ico {
        proxy_pass http://__SLUG___upstream;
        proxy_set_header Host $host;
        access_log off;
    }

    # /admin is blocked here rather than in the app, because src/proxy.ts skips
    # its auth check entirely when ADMIN_SECRET is unset — an empty env var
    # leaves the admin pages open to the public.
    #
    # To use admin: set ADMIN_SECRET in shared/.env, delete this block, reload.
    # To use admin from one office IP: replace `deny all` with
    #   allow 203.0.113.4;  deny all;
    location /admin {
        return 404;
    }

    location / {
        proxy_pass http://__SLUG___upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503;
        # Small buffers: Next HTML is typically tens of KB after the prerender
        # seed; large defaults waste RAM across 50 vhosts for no gain.
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_busy_buffers_size 32k;
    }
}
