{
  "name": "divya-safe-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "build:standalone": "npm run build && npm run prepare:standalone",
    "start": "next start -p 3001",
    "start:standalone": "PORT=${PORT:-3001} HOSTNAME=${HOSTNAME:-localhost} node .next/standalone/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop sk-invisible-grills",
    "pm2:logs": "pm2 logs sk-invisible-grills",
    "pm2:status": "pm2 status",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "pages:create": "tsx scripts/create-page-records.ts",
    "pages:audit": "tsx scripts/content-audit.ts",
    "pages:publish": "tsx scripts/publish-pages.ts",
    "pages:noindex": "tsx scripts/noindex-pages.ts",
    "pages:count": "tsx scripts/page-count.ts",
    "scale:capacity": "tsx scripts/scale-capacity.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "content:audit": "tsx scripts/content-audit.ts",
    "duplicates:audit": "tsx scripts/duplicate-audit.ts",
    "links:audit": "tsx scripts/internal-link-audit.ts",
    "schema:audit": "tsx scripts/schema-audit.ts",
    "sitemaps:generate": "tsx scripts/generate-sitemaps.ts",
    "seo:validate-sitemap": "tsx scripts/validate-sitemap.ts",
    "seo:keyword-ownership": "tsx scripts/keyword-ownership-report.ts",
    "seo:orphans": "tsx scripts/orphan-page-report.ts",
    "seo:link-health": "tsx scripts/link-health-report.ts",
    "seo:canonical-schema": "tsx scripts/canonical-schema-report.ts",
    "seo:qa": "tsx scripts/seo-qa.ts",
    "seo:test-set": "tsx scripts/seo-test-set.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "images:validate": "tsx scripts/validate-images.ts",
    "seo:thin-content": "tsx scripts/thin-content-report.ts",
    "placeholders:audit": "tsx scripts/placeholder-audit.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.5.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
